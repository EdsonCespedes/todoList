<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml" fx:controller="app.controller.RegisterController"
      spacing="15" alignment="CENTER" style="-fx-background-color: #f4f4f4; -fx-padding: 30;">

    <Label text="Registro de Usuario" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="emailField" promptText="Correo electrónico" maxWidth="250"/>
    <PasswordField fx:id="passwordField" promptText="Contraseña" maxWidth="250"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirmar contraseña" maxWidth="250"/>

    <Button text="Registrarse" onAction="#handleRegister" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 5 15 5 15;"/>

    <Label fx:id="statusLabel" textFill="red"/>
</VBox>


