<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.controller.TaskController">

    <top>
        <Label text="Gestor de Tareas" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox spacing="10" padding="10">
            <TableView fx:id="taskTable" prefHeight="200">
                <columns>
                    <TableColumn fx:id="taskColumn" text="Tarea" />
                    <TableColumn fx:id="statusColumn" text="Estado" />
                </columns>
            </TableView>

            <HBox spacing="10">
                <TextField fx:id="taskField" promptText="Nueva tarea..." />
                <ComboBox fx:id="statusComboBox" />
                <Button text="Agregar" onAction="#handleAddTask"/>
            </HBox>

            <HBox spacing="10">
                <ComboBox fx:id="sectionComboBox" />
                <Button text="Agregar sección" onAction="#handleAddSection"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
