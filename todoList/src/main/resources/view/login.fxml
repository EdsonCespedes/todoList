<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.controller.LoginController" prefWidth="400"
            prefHeight="250">
    <VBox spacing="10" alignment="CENTER" layoutX="50" layoutY="30">
        <Label text="Iniciar sesión" style="-fx-font-size: 18px;"/>
        <TextField fx:id="emailField" promptText="Correo electrónico"/>
        <PasswordField fx:id="contrasenaField" promptText="Contraseña"/>
        <Button fx:id="loginButton" text="Iniciar sesión" onAction="#handleLogin"/>
        <Hyperlink text="¿No tienes cuenta? Regístrate" onAction="#goToRegister"/>
        <Label fx:id="statusLabel" textFill="red"/>
    </VBox>
</AnchorPane>

